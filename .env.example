# Postgres
DATABASE_URL=postgres://dataexit:dataexit@localhost:5432/dataexit

# Per-user store encryption key (32-byte base64). Generate: openssl rand -base64 32
USER_STORE_KEY=

# Policy layer
UNDO_WINDOW_SECONDS=600

# WhatsApp Business API (apps/whatsapp-bot)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Default request language: en | hi
DEFAULT_LANGUAGE=en
