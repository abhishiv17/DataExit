# Copy to .env. Variables set by the MCP client config take precedence over this file.

# --- Gmail / Calendar ---------------------------------------------------------
# google = real Gmail via OAuth (run `npm run auth:google` once); fixture = offline demo mailbox.
# Default: google if a token exists, otherwise fixture.
GMAIL_BACKEND=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_PATH=.data/google-token.json
# GMAIL_FIXTURE=demo/seed-inbox/messages.json

# --- Sending safety -------------------------------------------------------------
# dry_run = nothing is sent (default with no SANDBOX_EMAIL)
# sandbox = every email goes to SANDBOX_EMAIL with the real recipient in the subject (default when SANDBOX_EMAIL is set)
# live    = emails go to the companies. Only on demo day, from the demo account.
SEND_MODE=sandbox
SANDBOX_EMAIL=
SEND_LIMIT_PER_HOUR=40
UNDO_WINDOW_SECONDS=600

# --- Storage ---------------------------------------------------------------------
# Empty = JSON file in .data/store.json (fine for the all-in-one server).
# Set this when running the servers as separate processes.
DATABASE_URL=
# csv (servers/company-directory/data/companies.csv) or postgres (companies table, after `npm run db:seed-directory`)
DIRECTORY_SOURCE=csv
# DATAEXIT_DATA_DIR=.data
DATAEXIT_USER_ID=local-user

# --- Discovery ---------------------------------------------------------------------
# Per search (signup/OTP and receipts are searched separately)
DISCOVERY_MAX_MESSAGES=3000
# 0 = whole mailbox (recommended: old signups are the most forgotten accounts)
DISCOVERY_LOOKBACK_YEARS=0

# --- Demo ---------------------------------------------------------------------------
# Start the clock at this moment (it keeps running), e.g. 2027-03-01T10:00:00+05:30, to show deadlines passing during the demo.
DATAEXIT_NOW=

# --- HTTP mode (claude.ai custom connector) ----------------------------------------
# Random 24+ character string; the endpoint is /mcp/<secret>.
MCP_HTTP_SECRET=
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8787

LOG_LEVEL=info

# --- WhatsApp Business API (apps/whatsapp-bot, Person B) ---------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- Telegram test bot ---------------------------------------------------------
# Create with @BotFather. Keep the token only in your local .env; never commit it.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat IDs from /chatid in a private chat or test group.
# AI and voice are disabled until this has at least one ID.
TELEGRAM_ALLOWED_CHAT_IDS=
# Sarvam speech-to-text, chat and text-to-speech. Keep this key private.
SARVAM_API_KEY=

# --- Scam-shield MCP AI --------------------------------------------------------
# auto uses Groq if configured, then Anthropic; none keeps rules-only mode.
SCAM_AI_PROVIDER=auto
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
